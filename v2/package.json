{
  "name": "threat-level-midnight-v2",
  "private": true,
  "version": "2.0.0-alpha.0",
  "description": "Threat Level Midnight: The Director's Cut. 3D physics fan game (unofficial, non-commercial).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4174",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "qa": "node tools/qa/play.mjs && node tools/qa/wrap.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/rapier": "^2.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.56.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
